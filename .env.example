# Markbase environment contract
# Copy this file to .env.local. Never commit populated .env files.

# --- GitHub OAuth mode (required unless AUTH_BYPASS=true in local development) ---
# Create an OAuth App at https://github.com/settings/developers.
# Local callback: http://localhost:3000/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Database and share encryption (required) ---
# PRISMA_DATABASE_URL is preferred when it contains a postgresql:// URL.
# prisma:// URLs are not supported by postgres.js.
PRISMA_DATABASE_URL=
POSTGRES_URL=
POSTGRES_SSL=require
POSTGRES_POOL_MAX=3
# Generate with: openssl rand -hex 32
SHARE_ENCRYPTION_KEY=

# --- Local bypass mode (development only; never enable in production) ---
AUTH_BYPASS=false
GITHUB_PAT=
GITHUB_BYPASS_USER_ID=
GITHUB_BYPASS_LOGIN=

# --- Optional GitHub webhook ---
GITHUB_WEBHOOK_SECRET=

# --- Optional AI summaries ---
# Keep false for private repositories until your provider/data policy is approved.
AI_SUMMARIES_ENABLED=false
# Fail closed for private or unknown repository visibility. Enable only after
# your provider/data-use policy is approved.
AI_PRIVATE_REPO_SUMMARIES_ENABLED=false
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Test-only flags (the app hard-rejects these in production) ---
MARKBASE_TEST_MODE=false
MARKBASE_TEST_SECRET=
# GITHUB_API_BASE_URL, GITHUB_WEB_BASE_URL, and GITHUB_RAW_BASE_URL are set by the E2E harness.
