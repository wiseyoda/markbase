{
  "name": "markbase",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24.13.0 <25",
    "pnpm": "10.27.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "env:check": "tsx scripts/env-check.mts",
    "db:migrate": "tsx scripts/db-migrate.mts",
    "db:status": "tsx scripts/db-status.mts",
    "lint": "eslint",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:headed": "pnpm build && playwright test --headed"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.135",
